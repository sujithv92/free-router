# Free Router — environment variables.
#
# Copy to `.env`, uncomment what you have, fill in the values. Do not commit
# `.env`. Lookup order, first non-empty value wins: the process environment,
# then this file, then `~/.hermes/.env`.
#
# Exactly one variable below is written as a real `NAME=` line: the caller
# token. Everything else is commented out, on purpose.
#
# SnapDeploy scans this file and lists every real `NAME=` line on its
# "Environment Variables Detected" screen, tagging each one Required — so 30
# optional variables written as real lines (one key per provider, plus
# Cloudflare's account id) would mean 30 fields blocking the Deploy button, for
# keys that are meant to be optional. A commented-out name is invisible to that
# scan, which is what keeps it documented but not mandatory.
#
# To use a provider:
#   - locally: uncomment its line here, in your `.env`;
#   - on SnapDeploy: click "+ Add Variable" on the deploy screen, or add it
#     later under Container Settings -> Environment Variables (a name you add
#     there is injected the same way a detected one is, and saving rolls the
#     container so it takes effect).
# Names ending in _KEY or _TOKEN are detected as Secrets and masked in the
# dashboard.
#
# Never write a value on a key line, not even a placeholder. SnapDeploy bakes
# whatever is prefilled into the container, and "value present" is exactly how
# Free Router decides a provider is configured: a placeholder makes a provider
# you have no account with look usable, so it joins the ranking and fails every
# request it is handed. Empty or absent means not configured, and the provider
# is dropped from routing, catalog refresh, and the model list.

# ---------------------------------------------------------------------------
# Required — the gateway's own credential, and the one line SnapDeploy asks for
# ---------------------------------------------------------------------------

# Shared secret for callers. This is not a provider key and you do not obtain
# it from anyone: you invent it. Generate one with `openssl rand -hex 32`, and
# keep it to hex — `start.sh` sources this file in a shell, so a value with
# spaces, `$`, backticks, or quotes is expanded by the shell instead of read as
# a secret. There is no format check and no reason to memorise it; you paste it
# once here and once per client.
#
# UNSET IS ONLY SAFE ON LOOPBACK: with no token, /v1/chat/completions spends
# your upstream quota for anyone who can reach the port, and /health publishes
# the whole provider layout. A container platform routes public traffic to you,
# so set this before deploying. Setting it also unlocks the web interface off
# loopback, which is the only way to reach the dashboard on a deployed
# instance. Send it as "Authorization: Bearer <token>".
FREE_ROUTER_API_KEY=

# ---------------------------------------------------------------------------
# Providers already configured — all optional, a missing key drops the provider
# ---------------------------------------------------------------------------

# OpenRouter: OpenRouter models, catalog refresh, and weekly discovery. This is
# the one key worth having first.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Google AI Studio Gemini free-tier Flash-Lite models.
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# TokenRouter free GLM-5.3 on the shared `free-best` ranking.
# TOKENROUTER_API_KEY=

# B.AI Limited Free models on the shared `free-best` ranking.
# https://chat.b.ai
# BAI_API_KEY=

# ---------------------------------------------------------------------------
# Standing free tiers, no credit card
# ---------------------------------------------------------------------------

# Groq — free tier, 30 RPM / 14,400 requests per day.
# https://console.groq.com/keys
# GROQ_API_KEY=

# Cerebras — free tier, ~1M tokens per day.
# https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# Mistral — free Experiment mode, ~1B tokens per month.
# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# GitHub Models — free with any GitHub PAT that has the `models:read` scope.
# https://github.com/settings/tokens
# GITHUB_API_KEY=

# NVIDIA NIM — free credit-based access to ~90 models.
# https://build.nvidia.com
# NVIDIA_API_KEY=

# Hugging Face Inference Providers — small standing monthly credit.
# https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=

# OVHcloud AI Endpoints — free tier, EU-hosted open weights.
# https://www.ovhcloud.com/en/public-cloud/ai-endpoints/
# OVHCLOUD_API_KEY=

# Chutes — free community tier.
# https://chutes.ai
# CHUTES_API_KEY=

# SambaNova Cloud — free tier, no credit card.
# https://cloud.sambanova.ai
# SAMBANOVA_API_KEY=

# Ollama Cloud — free model families from the Ollama library.
# https://ollama.com/settings/keys
# OLLAMA_API_KEY=

# OpenCode Zen — free registration, curated free models.
# https://opencode.ai/zen
# OPENCODE_API_KEY=

# Kilo Code gateway — free `:free` catalog.
# https://kilo.ai
# KILO_API_KEY=

# nScale — free registration tier.
# https://nscale.com
# NSCALE_API_KEY=

# DeepInfra — free model tier on an OpenAI-compatible endpoint.
# https://deepinfra.com/dash/api_keys
# DEEPINFRA_API_KEY=

# ---------------------------------------------------------------------------
# Provider-native free models
# ---------------------------------------------------------------------------

# Z.AI / Zhipu GLM — GLM-4.7-Flash, GLM-4.5-Flash and GLM-4.6V-Flash are free.
# https://z.ai
# ZHIPU_API_KEY=

# Moonshot Kimi.
# https://platform.kimi.ai
# MOONSHOT_API_KEY=

# DeepSeek.
# https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=

# Alibaba Qwen / Model Studio (international).
# https://modelstudio.console.alibabacloud.com
# QWEN_API_KEY=

# xAI Grok — spend from sign-up credits.
# https://console.x.ai
# XAI_API_KEY=

# Scaleway Generative APIs — gpt-oss and Devstral on free credits.
# https://console.scaleway.com
# SCALEWAY_API_KEY=

# AI21 Labs Jamba — trial credits.
# https://studio.ai21.com
# AI21_API_KEY=

# Nebius Token Factory.
# https://studio.nebius.com
# NEBIUS_API_KEY=

# Fireworks AI — $1 trial credit.
# https://fireworks.ai/api-keys
# FIREWORKS_API_KEY=

# ---------------------------------------------------------------------------
# Needs two variables: the account id is part of the URL, not a header
# ---------------------------------------------------------------------------

# Cloudflare Workers AI — 10,000 neurons per day free. CLOUDFLARE_ACCOUNT_ID is
# interpolated into the base URL in config.json; leaving either one unset
# disables the provider.
# https://dash.cloudflare.com
# CLOUDFLARE_API_KEY=
# CLOUDFLARE_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Trial credits only — no standing zero-cost models, so it routes nothing until
# you add model ids to the `openai` block in config.json
# ---------------------------------------------------------------------------

# https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Runtime overrides — all optional, each has a default
# ---------------------------------------------------------------------------

# Bind address. The Dockerfile pins this to 0.0.0.0; a platform reverse proxy
# cannot reach 127.0.0.1.
# FREE_ROUTER_HOST=0.0.0.0

# Listen port. SnapDeploy assigns and locks PORT; Free Router falls back to it
# automatically, so this override is only for local runs.
# FREE_ROUTER_PORT=8787

# Point the config at a file other than ./config.json.
# FREE_ROUTER_CONFIG=

# Per-upstream-attempt timeout in milliseconds.
# FREE_ROUTER_ATTEMPT_TIMEOUT_MS=180000

# Per-provider base URL overrides. Use these when a provider is served behind a
# gateway, or to supply an account-scoped URL such as Cloudflare's.
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCT/ai/v1

# OpenRouter attribution headers.
# OPENROUTER_HTTP_REFERER=http://127.0.0.1:8787
# OPENROUTER_APP_NAME=Free Router
